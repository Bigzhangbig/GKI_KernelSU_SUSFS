+/*
+ * lifecycle serializes the whole retire/grace/iput sequence with sb shutdown.
+ * Otherwise shutdown could miss an unlinked entry still holding an inode.
+ */
+static int susfs_publish_sus_kstat(struct st_susfs_sus_kstat_hlist *entry,
+				 bool is_update)
+{
+	struct st_susfs_sus_kstat_hlist *old;
+	long long size = entry->info.spoofed_size;
+	LIST_HEAD(retired);
+	int err = 0;
+
+	mutex_lock(&susfs_mutex_lock_sus_kstat_lifecycle);
+	mutex_lock(&susfs_mutex_lock_sus_kstat);
+	if (!(entry->pinned_inode->i_sb->s_flags & SB_ACTIVE)) {
+		err = -ESHUTDOWN;
+		goto out_unlock;
+	}
+	if (is_update) {
+		old = susfs_kstat_find_path_locked(entry->info.target_pathname);
+		if (!old) {
+			err = -ENOENT;
+			goto out_unlock;
+		}
+		memcpy(&entry->info, &old->info, sizeof(entry->info));
+		entry->info.target_ino = entry->target_ino;
+		entry->info.spoofed_size = size;
+	}
+	/* Full-table path replacement also removes historical duplicate paths. */
+	susfs_kstat_retire_path_locked(entry->info.target_pathname, &retired);
+	set_bit(AS_FLAGS_SUS_KSTAT, &entry->pinned_inode->i_mapping->flags);
+	hash_add_rcu(SUS_KSTAT_HLIST, &entry->node, entry->target_ino);
+	SUSFS_LOGI("KSTAT published path='%s' ino=%lu dev=%lu spoofino=%lu pinned=yes\n",
+		entry->info.target_pathname, entry->target_ino,
+		entry->target_dev, entry->info.spoofed_ino);
+out_unlock:
+	mutex_unlock(&susfs_mutex_lock_sus_kstat);
+	susfs_kstat_drain_retired(&retired);
+	mutex_unlock(&susfs_mutex_lock_sus_kstat_lifecycle);
 	return err;
 }
 
